VITE_API_BASE_URL=/api
VITE_APP_NAME=crumb
VITE_SUPPORT_EMAIL=support@example.com
VITE_PROFILE_API_MODE=remote

# Use in-browser mock data for features whose backend is not ready yet.
# In development this also opens /vendor/stores without login and provides
# editable sample store/request data. Never enable it in production.
VITE_USE_MOCK_API=false
