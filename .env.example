VITE_API_BASE_URL=/api
# Vite proxies /api to the Go backend. Use its origin (without a trailing API path).
API_PROXY_TARGET=http://localhost:8080
VITE_APP_NAME=crumb
VITE_SUPPORT_EMAIL=support@example.com
VITE_PROFILE_API_MODE=remote
# Development only; opt in with ?preview=1 on any vendor finance route.
VITE_VENDOR_FINANCE_PREVIEW=0
