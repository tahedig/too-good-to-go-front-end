# Use the immutable branch-and-commit tag produced by GitHub Actions.
FRONTEND_IMAGE=ghcr.io/tahedig/too-good-to-go-front-end:develop-<commit-sha>

# The Go backend exposes its routes on port 8080 without an /api prefix and
# should join this same Docker network with the service name "api".
BACKEND_UPSTREAM=http://api:8080
APP_NETWORK=staging-app

FRONTEND_BIND=192.168.6.229
FRONTEND_PORT=8080
