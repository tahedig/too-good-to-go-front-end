# Use the immutable branch-and-commit tag produced by GitHub Actions.
FRONTEND_IMAGE=ghcr.io/tahedig/too-good-to-go-front-end:develop-<commit-sha>

# The Go backend exposes its routes on port 8080 without an /api prefix.
# If both services share a Docker network, this can instead be http://api:8080.
BACKEND_UPSTREAM=http://host.docker.internal:8080

FRONTEND_PORT=8080
